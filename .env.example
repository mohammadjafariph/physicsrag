# ---- LLM provider -----------------------------------------------------------
# Any provider below works; pick one and set its model + key.
#   OpenAI-compatible: groq, openai, openrouter, deepseek, mistral, together,
#                      xai, ollama (local), lmstudio (local), vllm (local), custom
#   Anthropic:         anthropic
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional: overrides the provider's default base URL (needed for "custom")
LLM_BASE_URL=

# Legacy: the original pipeline used GROQ_KEY. Still honoured when
# LLM_PROVIDER=groq and LLM_API_KEY is empty.
GROQ_KEY=

# Per-stage model overrides (optional; default to LLM_MODEL)
#PLANNER_MODEL=
#ANALYZER_MODEL=
#DEDUP_MODEL=

# ---- Local embedding / reranking models (run on your machine) ---------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- HTTP API ---------------------------------------------------------------
#API_HOST=127.0.0.1
#API_PORT=8000

# ---- Data location ----------------------------------------------------------
#DATA_DIR=data